// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum MessageSender {
  CUSTOMER
  ADMIN
}

// ─── User ─────────────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String
  name          String
  role          Role      @default(CUSTOMER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  orders    Order[]
  messages  Message[]
  cartItems CartItem[]

  @@index([email])
}

// ─── Category ─────────────────────────────────────────────────────────────────

model Category {
  id        String   @id @default(cuid())
  name      String   @unique // e.g. "Figures", "Posters", "Accessories"
  slug      String   @unique // e.g. "figures", "posters"
  createdAt DateTime @default(now())

  products Product[]
}

// ─── Product ──────────────────────────────────────────────────────────────────

model Product {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  price       Decimal  @db.Decimal(10, 2) // current live price
  stock       Int      @default(0) // units available right now
  images      String[] // array of Cloudinary URLs
  isArchived  Boolean  @default(false) // hide without deleting
  isFeatured  Boolean  @default(false)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orderItems OrderItem[]
  cartItems  CartItem[]

  @@index([categoryId])
  @@index([slug])
}

// ─── Order ────────────────────────────────────────────────────────────────────

model Order {
  id          String      @id @default(cuid())
  status      OrderStatus @default(PENDING)
  totalAmount Decimal     @db.Decimal(10, 2) // sum of all OrderItem subtotals

  userId String
  user   User   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items OrderItem[]

  @@index([userId])
}

// ─── OrderItem ────────────────────────────────────────────────────────────────
// This is the key table for price snapshotting.
// priceAtPurchase stores what the customer actually paid — completely
// independent of Product.price, which can change freely after the order.

model OrderItem {
  id              String  @id @default(cuid())
  quantity        Int
  priceAtPurchase Decimal @db.Decimal(10, 2) // ← snapshot of price at checkout

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}

// ─── CartItem ────────────────────────────────────────────────────────────────
// Logged-in customer cart.
// Adding to cart does not reduce stock.
// Stock is checked and reduced later during checkout.

model CartItem {
  id       String @id @default(cuid())
  quantity Int

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
}

// ─── Message ──────────────────────────────────────────────────────────────────
// One chat thread per customer with the admin.
// sender enum tells you who wrote it without needing a second join.

model Message {
  id        String        @id @default(cuid())
  body      String
  sender    MessageSender
  isRead    Boolean       @default(false) // for unread badge in admin panel
  createdAt DateTime      @default(now())

  userId String // always the customer's ID, regardless of who sent it
  user   User   @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
}
